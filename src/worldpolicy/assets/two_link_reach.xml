<mujoco model="two_link_reach_v1">
  <compiler angle="radian"/>
  <option timestep="0.005" gravity="0 0 0" integrator="implicitfast"/>
  <visual><global offwidth="96" offheight="96"/></visual>
  <worldbody>
    <light pos="0 -1 2" dir="0 0 -1"/>
    <camera name="overview" pos="0.5 -1.5 0.8" xyaxes="1 0 0 0 0.4 1"/>
    <geom type="plane" size="1 1 0.01" pos="0 0 -0.1" rgba="0.8 0.8 0.8 1"/>
    <body name="base" pos="0 0 0.2">
      <joint name="shoulder" type="hinge" axis="0 1 0" range="-2.4 2.4" damping="0.5" armature="0.02"/>
      <geom name="upper" type="capsule" fromto="0 0 0 0.35 0 0" size="0.025" mass="0.4" rgba="0.2 0.4 0.8 1"/>
      <body name="forearm" pos="0.35 0 0">
        <joint name="elbow" type="hinge" axis="0 1 0" range="-2.4 2.4" damping="0.4" armature="0.01"/>
        <geom name="lower" type="capsule" fromto="0 0 0 0.3 0 0" size="0.02" mass="0.3" rgba="0.2 0.7 0.6 1"/>
        <site name="tip" pos="0.3 0 0" size="0.02" rgba="1 0 0 1"/>
      </body>
    </body>
    <site name="target" pos="0.5 0 -0.05" size="0.035" rgba="0 1 0 0.8"/>
  </worldbody>
  <actuator>
    <position name="shoulder_servo" joint="shoulder" kp="30" kv="2" ctrlrange="-2.4 2.4"/>
    <position name="elbow_servo" joint="elbow" kp="30" kv="2" ctrlrange="-2.4 2.4"/>
  </actuator>
</mujoco>
